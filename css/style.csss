:root {
  --primary-color: #8b5cf6;
  --secondary-color: #ec4899;
  --dark-bg: #0f172a;
  --light-text: #f1f5f9;
  --card-bg: #1e293b;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  direction: rtl;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(135deg, var(--dark-bg) 0%, #1a1f3a 100%);
  color: var(--light-text);
  min-height: 100vh;
  scroll-behavior: smooth;
}

body {
  padding: 15px;
}

/* ========== الرأس ========== */
header {
  background: rgba(15, 23, 42, 0.8);
  padding: 20px 15px;
  border-bottom: 2px solid var(--primary-color);
  border-radius: 10px;
  margin-bottom: 25px;
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(10px);
}

header h1 {
  font-size: 28px;
  text-align: center;
  margin-bottom: 15px;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ========== القوائم ========== */
nav ul {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
  margin-bottom: 15px;
}

nav a {
  color: var(--light-text);
  text-decoration: none;
  background: rgba(139, 92, 246, 0.2);
  padding: 8px 15px;
  border-radius: 20px;
  font-size: 13px;
  border: 1px solid var(--primary-color);
  transition: all 0.3s;
  cursor: pointer;
}

nav a:hover, nav a.active {
  background: var(--primary-color);
  color: white;
}

/* ========== البحث والفلاتر ========== */
.search-container {
  margin-bottom: 20px;
}

.search-container input {
  width: 100%;
  padding: 12px 15px;
  border: 2px solid var(--primary-color);
  background: rgba(139, 92, 246, 0.1);
  color: var(--light-text);
  border-radius: 8px;
  font-size: 14px;
  margin-bottom: 12px;
}

.search-container input::placeholder {
  color: rgba(241, 245, 249, 0.5);
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
}

.filter-btn {
  background: rgba(139, 92, 246, 0.2);
  border: 2px solid var(--primary-color);
  color: var(--light-text);
  padding: 8px 12px;
  border-radius: 20px;
  font-size: 12px;
  cursor: pointer;
  transition: all 0.3s;
}

.filter-btn.active {
  background: var(--primary-color);
  color: white;
}

/* ========== البطاقات ========== */
.container {
  max-width: 100%;
  margin: 0 auto;
  padding: 0;
}

.stories-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 15px;
  margin-bottom: 30px;
}

.story-card {
  background: var(--card-bg);
  border: 1px solid rgba(139, 92, 246, 0.3);
  border-radius: 12px;
  padding: 18px;
  cursor: pointer;
  transition: all 0.3s;
  overflow: hidden;
}

.story-card:hover {
  border-color: var(--secondary-color);
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(236, 72, 153, 0.2);
}

.story-card h3 {
  font-size: 18px;
  margin-bottom: 8px;
  color: var(--primary-color);
}

.story-card .category {
  display: inline-block;
  background: rgba(236, 72, 153, 0.2);
  color: var(--secondary-color);
  padding: 4px 10px;
  border-radius: 15px;
  font-size: 11px;
  margin-bottom: 10px;
}

.story-card .description {
  font-size: 13px;
  line-height: 1.6;
  margin-bottom: 12px;
  color: rgba(241, 245, 249, 0.8);
}

.story-card .author {
  font-size: 12px;
  color: rgba(139, 92, 246, 0.8);
  margin-bottom: 12px;
}

.read-btn {
  width: 100%;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
  color: white;
  border: none;
  padding: 10px;
  border-radius: 6px;
  font-size: 14px;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.3s;
}

.read-btn:hover {
  transform: scale(1.02);
  box-shadow: 0 5px 20px rgba(236, 72, 153, 0.4);
}

/* ========== الـ Modal ========== */
.modal {
  display: none;
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  overflow: auto;
  padding: 20px;
}

.modal.show {
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: var(--card-bg);
  padding: 25px;
  border-radius: 12px;
  max-width: 95%;
  max-height: 90vh;
  overflow-y: auto;
  border: 2px solid var(--primary-color);
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(50px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-content h2 {
  font-size: 22px;
  margin-bottom: 10px;
  color: var(--primary-color);
}

.modal-content p {
  font-size: 14px;
  line-height: 1.8;
  margin-bottom: 15px;
  color: rgba(241, 245, 249, 0.9);
}

.close-btn {
  background: var(--secondary-color);
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 14px;
  margin-top: 15px;
  width: 100%;
}

/* ========== نموذج الاتصال ========== */
.contact-form {
  background: var(--card-bg);
  padding: 20px;
  border-radius: 12px;
  border: 1px solid rgba(139, 92, 246, 0.3);
  margin-top: 30px;
}

.contact-form h2 {
  font-size: 20px;
  margin-bottom: 15px;
  color: var(--primary-color);
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 12px;
  margin-bottom: 12px;
  border: 1px solid rgba(139, 92, 246, 0.3);
  background: rgba(139, 92, 246, 0.1);
  color: var(--light-text);
  border-radius: 6px;
  font-size: 14px;
  font-family: inherit;
  resize: vertical;
  min-height: 80px;
}

.contact-form button {
  width: 100%;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
  color: white;
  border: none;
  padding: 12px;
  border-radius: 6px;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.3s;
}

.contact-form button:hover {
  transform: scale(1.02);
}

/* ========== التنبيهات ========== */
.alert {
  padding: 12px;
  border-radius: 6px;
  margin-bottom: 15px;
  text-align: center;
  font-size: 13px;
}

.alert-info {
  background: rgba(139, 92, 246, 0.2);
  color: var(--primary-color);
  border: 1px solid var(--primary-color);
}

/* ========== Responsive للجوال ========== */
@media (max-width: 768px) {
  body {
    padding: 10px;
  }

  header {
    padding: 15px 10px;
    margin-bottom: 20px;
  }

  header h1 {
    font-size: 24px;
  }

  nav ul {
    gap: 8px;
  }

  nav a {
    font-size: 12px;
    padding: 6px 12px;
  }

  .stories-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .story-card {
    padding: 15px;
  }

  .story-card h3 {
    font-size: 16px;
  }

  .modal-content {
    padding: 20px;
    max-width: 98%;
  }

  .contact-form {
    padding: 15px;
  }
}

@media (max-width: 480px) {
  body {
    padding: 8px;
  }

  header h1 {
    font-size: 20px;
  }

  .story-card h3 {
    font-size: 15px;
  }

  .story-card .description {
    font-size: 12px;
  }

  nav a {
    font-size: 11px;
    padding: 5px 10px;
  }
}
